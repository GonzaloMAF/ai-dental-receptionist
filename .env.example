# ---------- Servidor ----------
PORT=3000
# Secreto compartido entre el servidor y Vapi (invéntalo, p. ej. 24 caracteres aleatorios)
VAPI_SECRET=cambia-esto
# Clave para ver el panel: http://localhost:3000/panel?key=ESTA_CLAVE
PANEL_KEY=cambia-esto-tambien
# ID del calendario (Ajustes del calendario > Integrar calendario > ID del calendario)
CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# Ruta al JSON de la cuenta de servicio de Google (recomendado)
GOOGLE_SA_FILE=./google-sa.json
# Alternativa para hostings: JSON en una línea (y GOOGLE_SA_B64=1 si va en base64)
# GOOGLE_SA_JSON=

# ---------- Solo para el script `npm run asistente` ----------
# URL pública del túnel o del hosting, sin barra final: https://xxxx.trycloudflare.com
PUBLIC_URL=
# Vapi → Dashboard → API Keys
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Rellénalo después de la primera ejecución para ACTUALIZAR en vez de crear otro asistente
VAPI_ASSISTANT_ID=
